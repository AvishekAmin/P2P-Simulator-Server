NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@localhost:5432/p2p_simulator
# Non-pooled connection, used by Prisma CLI (migrate/seed/studio) for the shadow database.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/p2p_simulator

REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ORIGIN=http://localhost:3000

# No-auth MVP tenant context (src/middleware/auth.ts). Replace with real
# Clerk-derived userId/organizationId when auth is added.
DEV_ORGANIZATION_ID=dev-org
DEV_USER_ID=dev-user
